# === Required for live signals / leaderboard ===
FOMO_API_KEY=your_fomo_api_key_here

# === Safety (default dry-run: no transactions) ===
DRY_RUN=true

# === Who to copy (optional overrides; YAML defaults: leaderboard / 7d / top 3) ===
# TRADER_SOURCE=leaderboard
# LEADERBOARD_WINDOW=7d
# LEADERBOARD_TOP_N=3
# LEADERBOARD_REFRESH_HOURS=6
# TRADER_SOURCE=manual   # then fill traders: in config.yaml

# === Chains (default: Solana only). Comma-separated: solana | solana,base ===
ENABLED_CHAINS=solana

# === Solana execution (only needed when DRY_RUN=false and copying Solana) ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Base58 secret key — NEVER commit a real key. Prefer a fresh wallet with small balance.
SOLANA_PRIVATE_KEY=
# Optional Jupiter portal key for higher rate limits (x-api-key)
JUPITER_API_KEY=

# === Base (EVM) — OPTIONAL. Only needed if ENABLED_CHAINS includes base
#     or config chains.base: true. Default is Solana-only; leave these empty.
# BASE_RPC_URL=https://mainnet.base.org
# BASE_PRIVATE_KEY=
# 0x Swap API key — https://dashboard.0x.org/create-account
# Docs: https://docs.0x.org/docs/introduction/quickstart/getting-started
# Sent as header 0x-api-key. Required only when Base is enabled.
# ZEROX_API_KEY=

# === Telegram (first-class: entries/exits/skips/PnL + /status /positions /pause /resume) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional but recommended for group chats: only these Telegram user ids may run commands
# (/pause /resume /status …). Comma-separated. Find yours via @userinfobot (the "Id" field).
# TELEGRAM_ALLOWED_USER_IDS=123456789

# === Paths ===
CONFIG_PATH=./config.yaml
DATA_DIR=./data
KILL_SWITCH_PATH=./kill.switch
